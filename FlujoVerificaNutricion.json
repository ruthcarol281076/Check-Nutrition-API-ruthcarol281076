    {
      "parameters": {
        "jsCode": "/**\n * Evalúa un producto según el Conteo de Semáforo y Nutri-Score.\n */\nfunction evaluarProducto(producto) {\n  let altos = 0;\n  if (producto.azucar > 22.5) altos++;\n  if (producto.sal > 1.5) altos++;\n  if (producto.grasa > 17.5) altos++;\n\n  let resultadoSemaforo = '';\n  if (altos === 0) {\n    resultadoSemaforo = 'saludable';\n  } else if (altos === 1) {\n    resultadoSemaforo = 'moderado';\n  } else {\n    resultadoSemaforo = 'no saludable';\n  }\n\n  let grade = (producto.nutriscore_grade || '').toString().toLowerCase();\n  let resultadoNutriscore = '';\n  if (grade === 'a' || grade === 'b') {\n    resultadoNutriscore = 'saludable';\n  } else if (grade === 'c') {\n    resultadoNutriscore = 'moderado';\n  } else if (grade === 'd' || grade === 'e') {\n    resultadoNutriscore = 'no saludable';\n  } else if (grade === 'unknown') {\n    resultadoNutriscore = 'desconocido';\n  } else {\n    resultadoNutriscore = 'desconocido';\n  }\n  \n  let resultadoFinal = '';\n  switch (resultadoNutriscore) {\n    case \"no saludable\":\n      resultadoFinal = \"no saludable\";\n      break;\n    case \"moderado\":\n      switch (resultadoSemaforo) {\n        case \"no saludable\":\n          resultadoFinal = \"no saludable\";\n          break;\n        case \"moderado\":\n          resultadoFinal = \"moderado\";\n          break;\n        case \"saludable\":\n          resultadoFinal = \"moderado\";\n          break;  \n        default:\n          resultadoFinal = \"desconocido\";\n          break;\n      }\n    case \"saludable\":\n      switch (resultadoSemaforo) {\n        case \"no saludable\":\n          resultadoFinal = \"no saludable\";\n          break;\n        case \"moderado\":\n          resultadoFinal = \"moderado\";\n          break;\n        case \"saludable\":\n          resultadoFinal = \"saludable\";\n          break;  \n        default:\n          resultadoFinal = \"desconocido\";\n          break;\n      } \n      break;\n    default:\n      resultadoFinal = \"desconocido\";\n      break;\n  }\n  \n  return {\n    nutrientesAltos_detectados: altos,\n    semaforo: resultadoSemaforo,\n    nutriscore: resultadoNutriscore,\n    coinciden: resultadoSemaforo === resultadoNutriscore,\n    resultadoFinalEntregado: resultadoFinal \n  };\n}\n\nconst results = [];\nfor (const item of $input.all()) {\n  const alimento = {\n    azucar: item.json.nutriment_sugar,\n    sal: item.json.nutriment_salt,\n    grasa: item.json.nutriment_fat,\n    nutriscore_grade: item.json.nutri_score\n  };\n  results.push({ json: { ...item.json, ...evaluarProducto(alimento) } });\n}\n\nreturn results;"
      },
      "id": "e3bcae77-5cab-4ffe-aa71-0b3110510c30",
